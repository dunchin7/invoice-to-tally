# ─────────────────────────────────────────────
# Azure OpenAI (required — default LLM provider)
# ─────────────────────────────────────────────
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-instance.openai.azure.com
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# Set to "gemini" to use Google Gemini instead of Azure OpenAI
LLM_PROVIDER=azure_openai

# ─────────────────────────────────────────────
# Google Gemini (only required when LLM_PROVIDER=gemini)
# ─────────────────────────────────────────────
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL_NAME=models/gemini-flash-latest

# ─────────────────────────────────────────────
# LLM retry behaviour (optional)
# ─────────────────────────────────────────────
EXTRACT_RETRY_ATTEMPTS=3
EXTRACT_RETRY_BASE_DELAY_SECONDS=1.0

# ─────────────────────────────────────────────
# OCR binaries (optional — uses system PATH if unset)
# ─────────────────────────────────────────────
# TESSERACT_CMD=/usr/bin/tesseract
# POPPLER_PATH=/usr/bin

# OCR language hint (e.g. "eng", "hin+eng")
OCR_LANGUAGE=eng

# Per-tenant language overrides as JSON map
# OCR_TENANT_LANGUAGE_OVERRIDES={"tenant_a": "hin+eng", "tenant_b": "eng"}

# ─────────────────────────────────────────────
# OCR preprocessing (optional, default all off)
# ─────────────────────────────────────────────
OCR_PREPROCESS_DESKEW=false
OCR_PREPROCESS_BINARIZATION=false
OCR_PREPROCESS_CONTRAST_ENHANCEMENT=false

# ─────────────────────────────────────────────
# OCR limits (optional)
# ─────────────────────────────────────────────
OCR_TIMEOUT_SECONDS=60
OCR_MAX_PAGES=20

# ─────────────────────────────────────────────
# Tally ERP connection (required for live upload)
# ─────────────────────────────────────────────
TALLY_HOST=localhost
TALLY_PORT=9000
TALLY_COMPANY=Your Company Name

TALLY_TIMEOUT_SECONDS=15
TALLY_MAX_RETRIES=3
TALLY_RETRY_BACKOFF_SECONDS=1.0

# Voucher type override (defaults to "Sales")
# TALLY_VOUCHER_TYPE=Sales
# TALLY_VOUCHER_ACTION=Create

# ─────────────────────────────────────────────
# Tally ledger names — must match your chart of accounts exactly
# ─────────────────────────────────────────────
TALLY_SALES_LEDGER=Sales
TALLY_CGST_LEDGER=Output CGST
TALLY_SGST_LEDGER=Output SGST
TALLY_IGST_LEDGER=Output IGST
TALLY_ROUND_OFF_LEDGER=Round Off

# Max round-off (INR) tolerated when line items don't exactly reconcile to header total.
# Cumulative rounding in line items + small OCR/LLM extraction errors often produce
# 1-10 INR delta; 50 is a safe default.
TALLY_MAX_ROUND_OFF=50
